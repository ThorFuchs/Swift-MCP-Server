{
  "name": "get_article_outline",
  "description": "Resolve a returned fixture candidate to an exact cached revision and ordered section locators. Use its snapshot and part locators for reading; expired snapshots are explicit errors.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "project": {
        "const": "fixture-enwiki"
      },
      "candidateID": {
        "type": "string",
        "maxLength": 128
      }
    },
    "required": [
      "project",
      "candidateID"
    ]
  },
  "outputSchema": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok"
          },
          "value": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "snapshot": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "provider": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "project": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "pageID": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "revisionID": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "normalizerVersion": {
                    "type": "string",
                    "maxLength": 128
                  }
                },
                "required": [
                  "provider",
                  "project",
                  "pageID",
                  "revisionID",
                  "normalizerVersion"
                ]
              },
              "provenance": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "identity": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "provider": {
                        "type": "string",
                        "maxLength": 128
                      },
                      "project": {
                        "type": "string",
                        "maxLength": 128
                      },
                      "pageID": {
                        "type": "string",
                        "maxLength": 128
                      },
                      "revisionID": {
                        "type": "string",
                        "maxLength": 128
                      },
                      "normalizerVersion": {
                        "type": "string",
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "provider",
                      "project",
                      "pageID",
                      "revisionID",
                      "normalizerVersion"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "sourceURL": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "retrievedAt": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "modifiedAt": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "language": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "license": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "synthetic": {
                    "const": true
                  }
                },
                "required": [
                  "identity",
                  "title",
                  "sourceURL",
                  "retrievedAt",
                  "license",
                  "synthetic"
                ]
              },
              "introduction": {
                "type": "string",
                "maxLength": 1024
              },
              "sections": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "location": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "snapshot": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "provider": {
                              "type": "string",
                              "maxLength": 128
                            },
                            "project": {
                              "type": "string",
                              "maxLength": 128
                            },
                            "pageID": {
                              "type": "string",
                              "maxLength": 128
                            },
                            "revisionID": {
                              "type": "string",
                              "maxLength": 128
                            },
                            "normalizerVersion": {
                              "type": "string",
                              "maxLength": 128
                            }
                          },
                          "required": [
                            "provider",
                            "project",
                            "pageID",
                            "revisionID",
                            "normalizerVersion"
                          ]
                        },
                        "partID": {
                          "type": "string",
                          "maxLength": 128
                        }
                      },
                      "required": [
                        "snapshot",
                        "partID"
                      ]
                    },
                    "parentPartID": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "depth": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 32
                    },
                    "heading": {
                      "type": "string",
                      "maxLength": 512
                    }
                  },
                  "required": [
                    "location",
                    "depth"
                  ]
                },
                "maxItems": 128
              },
              "totalSections": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4096
              },
              "referenceCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4096
              },
              "tableCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 128
              },
              "truncated": {
                "type": "boolean"
              },
              "introductionTruncated": {
                "type": "boolean"
              }
            },
            "required": [
              "snapshot",
              "provenance",
              "sections",
              "totalSections",
              "tableCount",
              "truncated",
              "introductionTruncated"
            ]
          }
        },
        "required": [
          "status",
          "value"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "error"
          },
          "problem": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "invalid_arguments",
                  "project_not_allowed",
                  "unknown_candidate",
                  "absent_page",
                  "absent_snapshot",
                  "absent_section",
                  "revision_mismatch",
                  "ambiguous_title",
                  "missing_references",
                  "unsupported_variant",
                  "budget_exceeded",
                  "upstream_unavailable",
                  "upstream_rate_limited",
                  "upstream_timed_out",
                  "invalid_fixture"
                ]
              },
              "message": {
                "type": "string",
                "maxLength": 512
              },
              "recovery": {
                "type": "string",
                "maxLength": 1024
              }
            },
            "required": [
              "code",
              "message",
              "recovery"
            ]
          }
        },
        "required": [
          "status",
          "problem"
        ]
      }
    ]
  },
  "annotations": {
    "title": "Get Article Outline",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
